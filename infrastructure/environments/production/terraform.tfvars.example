aws_region       = "ap-south-1"
domain_name      = "perkhaven.com"
backend_image_uri = "890839646565.dkr.ecr.ap-south-1.amazonaws.com/perkhaven-backend:replace-with-commit-sha"

# Reuse an existing hosted zone instead of creating a second one:
# create_route53_zone = false
# route53_zone_id      = "Z0123456789ABCDEFG"

# Optional. AWS sends a confirmation request before notifications begin.
# alert_email = "operations@perkhaven.com"

# Keep these production safeguards enabled.
database_deletion_protection = true
database_skip_final_snapshot = false
